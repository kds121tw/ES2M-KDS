# ===== ES2 WebMUD: local/generated files not for GitHub =====
node_modules/
*.log
logs/
log/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
*.zip
*.7z
*.rar
__pycache__/
*.pyc
.pytest_cache/

# Formal player/login data must never be public
# (only the .keep placeholders are tracked, so a fresh clone can save characters)
source/upstream/mudlib/data/user/*
!source/upstream/mudlib/data/user/.keep
source/upstream/mudlib/data/login/*
!source/upstream/mudlib/data/login/.keep

# Runtime-generated data
source/upstream/mudlib/log/
source/upstream/mudlib/logs/
.local-test/
localtest-start.log

# 橋接程式與遊戲共用的暗號、同 IP 限制設定（主機各自產生，不放進 git）
source/upstream/mudlib/adm/etc/bridge_secret
source/upstream/mudlib/data/iplimit.o

# 玩家版天朝圖鑑：部署時由 tools/build_player_codex.py 產生
web/codex.html

# Neolith 編譯中間檔（每台機器自己編譯產生，不放進 git）
# 例外：Windows 單機測試版直接使用 build-vs2022 的 neolith.exe，朋友不必自己編譯，所以保留這一個檔
source/upstream/neolith/build-linux/
source/upstream/neolith/build-vs2022/*
!source/upstream/neolith/build-vs2022/src/
source/upstream/neolith/build-vs2022/src/*
!source/upstream/neolith/build-vs2022/src/Release/
source/upstream/neolith/build-vs2022/src/Release/*
!source/upstream/neolith/build-vs2022/src/Release/neolith.exe
